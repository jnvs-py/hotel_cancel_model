  "cards": [
    {
      "dot": "cyan",
      "title": "Un solo contrato",
      "items": [
        "schema.py congela el orden de features: entrenamiento e inferencia comparten columna por posicion",
        "La limpieza tolerante alimenta el entrenamiento; la estricta protege /predict",
        "config.py es la unica fuente de verdad de rutas, seed y rangos"
      ]
    },
    {
      "dot": "amber",
      "title": "Artefacto auditable",
      "items": [
        "Todo el preprocesamiento vive dentro del Pipeline de sklearn",
        "metadata.json registra model_version derivada por CI y fingerprint de codigo+datos+lock",
        "load_model rechaza el artefacto si la version de sklearn no coincide"
      ]
    },
    {
      "dot": "emerald",
      "title": "Servicio reproducible",
      "items": [
        "La imagen se construye con el artefacto ya entrenado: no se entrena en runtime",
        "El contenedor corre como appuser no-root en amd64",
        "CI/CD deriva la version y publica releases con el joblib adjunto"
      ]
    }
  ]
