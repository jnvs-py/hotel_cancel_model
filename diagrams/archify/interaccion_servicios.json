  "cards": [
    {
      "dot": "cyan",
      "title": "Un push, dos workflows",
      "items": [
        "CI deriva la version del modelo ({pyproject}+{sha}) y el fingerprint de lo que afecta al entrenamiento",
        "El mismo gate de calidad corre en ambos workflows",
        "El job de docker construye la imagen con el modelo ya entrenado"
      ]
    },
    {
      "dot": "amber",
      "title": "Dedup por fingerprint",
      "items": [
        "Un commit que solo toca docs no cambia el fingerprint: no hay release",
        "Si el fingerprint cambio, el release publica joblib y metadata.json",
        "El caso sin cambio termina silencioso: nada que publicar"
      ]
    },
    {
      "dot": "emerald",
      "title": "Consumo y futuro",
      "items": [
        "El contenedor sirve /health, /ready, /predict y /model-info en el puerto que pida PORT",
        "El consumidor recibe prediccion, model_version y request_id",
        "El despliegue cloud reutiliza el mismo proceso y activara API_KEY"
      ]
    }
  ]
